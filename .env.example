# Promptsheon Environment Configuration (TypeScript port)
# Copy to .env and fill in. All variables prefixed with PROMPTSHEON_.

# Server
PROMPTSHEON_PORT=8080
PROMPTSHEON_HOST=127.0.0.1
PROMPTSHEON_DB_PATH=promptsheon.db
PROMPTSHEON_CAS_PATH=.promptsheon
PROMPTSHEON_FRONTEND_PATH=./frontend/.next
PROMPTSHEON_CORS_ORIGIN=http://localhost:3000
PROMPTSHEON_LOG_LEVEL=info

# Authentication
PROMPTSHEON_AUTH=false
PROMPTSHEON_JWT_SECRET=

# LLM (Strands Agents SDK)
# Set the provider here, OR pick one interactively during onboarding
# at /onboarding. When using the 'custom' provider, the onboarding
# step captures a baseUrl and the key inline.
PROMPTSHEON_LLM_PROVIDER=openai
PROMPTSHEON_LLM_MODEL=gpt-4
PROMPTSHEON_LLM_API_KEY_ENV=OPENAI_API_KEY
PROMPTSHEON_LLM_MAX_RETRIES=5
PROMPTSHEON_LLM_TIMEOUT_MS=120000

# Base URL overrides — for OpenAI-compatible or Anthropic-compatible
# gateways (LiteLLM, MiniMax, custom proxy). The onboarding step sets
# these when the user picks a non-preset provider.
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# LLM_BASE_URL=

# Provider API keys. Only one is needed; the onboarding step writes
# whichever is appropriate to the right env var.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_BEDROCK_REGION=us-east-1

# Self-Evolution
PROMPTSHEON_SELF_EVOLVE_ENABLED=false
PROMPTSHEON_SELF_EVOLVE_COOLDOWN_SEC=900
PROMPTSHEON_SELF_EVOLVE_MAX_CONCURRENT=3

# Observability (OpenTelemetry)
PROMPTSHEON_OTEL_ENDPOINT=

# Frontend dev rewrites /api/* → http://localhost:8080/api/* (see
# frontend/next.config.ts). Both servers must run in parallel.
