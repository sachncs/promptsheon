# Personal cruft
arc-agi/
environment_files/

# Binaries (anchored so the pattern doesn't match nested paths
# like deploy/helm/promptsheon/, frontend/, etc.)
bin/

# Cross-platform build artifacts
*.exe
*.test
*.out

# SQLite runtime artefacts (tests + dev daemons)
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment files
.env
.env.*
!.env.example

# IDE and editor state
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Go coverage profiles
coverage.out
coverage.html
*.prof

# Fuzz test corpus (regenerated by `go test -fuzz=...`)
**/testdata/fuzz/

# Node / TypeScript (sdk/typescript + frontend)
sdk/typescript/node_modules/
sdk/typescript/dist/
sdk/typescript/*.tsbuildinfo
sdk/typescript/coverage/
frontend/node_modules/
frontend/screenshots/
frontend/dist/

# Secret material — never commit
*.pem
*.key
*.cert
.secret
.credentials

# Logs
*.log

# Bench artefacts (regenerated by `make bench` /
# scripts/check-bench-regression.sh)
bench.txt
scripts/bench-current.txt

# Local promptsheon state directory
.promptsheon/

# vendor/ is committed for reproducible CI builds; not ignored.