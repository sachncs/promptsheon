# Personal cruft
arc-agi/
environment_files/

# Binaries
bin/

# Cross-platform build artifacts
*.exe
*.test
*.out

# SQLite runtime artefacts (tests + dev)
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment files
.env
.env.*
!.env.example

# IDE and editor state
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Coverage profiles
coverage.out
coverage.html
*.prof

# TypeScript / Node (packages/)
node_modules/
dist/
*.tsbuildinfo
coverage/
web/screenshots/
web/dist/

# Frontend (Next.js) — build artefacts only; frontend/.gitignore covers
# the rest (node_modules, .next, out, build, .env*, etc).
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/

# Secret material — never commit
*.pem
*.key
*.cert
.secret
.credentials

# Logs
*.log

# Local promptsheon state directory
.promptsheon/

# Temporary files
.tmp/
*.tmp

# OpenCode session artefacts
.opencode/

# Root-level empty pnpm-lock.yaml — workspace lockfiles under
# packages/ and frontend/ are intentionally committed.
/pnpm-lock.yaml
