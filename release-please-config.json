# release-please configuration. https://github.com/googleapis/release-please
#
# Generates release PRs from conventional-commit messages. Tag
# pattern is v*; components are the SDKs and the daemon (each gets
# a CHANGELOG section). Release PRs are auto-created on push to
# master and squash-merged, triggering publish-python.yml +
# publish-npm.yml + goreleaser.

config:
  release-type: go
  tag-separator: '/'
  include-component-in-tag: false
  include-v-in-tag: true

packages:
  .:
    component: daemon
    release-as: 1.0.0
    bump-minor-pre-major: false
    bump-patch-for-minor-pre-major: false
    changelog-path: CHANGELOG.md
    pull-request-title-pattern: 'chore(${scope}): release ${version}'
  sdk/python:
    component: python-sdk
    release-as: 1.0.0
    changelog-path: sdk/python/CHANGELOG.md
  sdk/typescript:
    component: typescript-sdk
    release-as: 1.0.0
    changelog-path: sdk/typescript/CHANGELOG.md

bootstrap-sha: 0b2bd98
branches:
  - main: master
plugins:
  - sentence-case
