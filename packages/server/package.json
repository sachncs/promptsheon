{
  "name": "@promptsheon/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "bench:security": "node --import tsx src/security/benchmark-cli.ts",
    "firewall": "node --import tsx src/firewall/cli.ts",
    "db:replicate": "node --import tsx src/replication/cli.ts",
    "db:failover": "node --import tsx src/replication/failover-cli.ts",
    "db:backup": "node --import tsx src/db/backup-cli.ts",
    "db:restore": "node --import tsx src/db/restore-cli.ts",
    "cas:verify": "node --import tsx src/cas/verify-cli.ts",
    "policy:eval": "node --import tsx src/policy/eval-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1142.0",
    "@cedar-policy/cedar-wasm": "^4.12.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@promptsheon/shared": "workspace:*",
    "@strands-agents/harness": "^0.1.1",
    "@strands-agents/sdk": "^1.19.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.2.0",
    "pino": "^10.3.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
