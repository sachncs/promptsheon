---
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL;

interface NavLink {
  label: string;
  href: string;
  external?: boolean;
}

const links: NavLink[] = [
  { label: 'Overview',     href: `${base}#overview` },
  { label: 'Who it is for',  href: `${base}#audience` },
  { label: 'Capabilities', href: `${base}#capabilities` },
  { label: 'Workflow',     href: `${base}#workflow` },
  { label: 'Trust',        href: `${base}#trust` },
  { label: 'Docs',         href: `${base}docs/` },
];
---

<header
  id="site-nav"
  class="sticky top-0 z-40 w-full border-b border-transparent transition-all duration-300"
>
  <div class="ps-container">
    <div class="flex h-16 items-center justify-between gap-6">
      <Logo size="sm" />

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="rounded-full px-3 py-1.5 text-[13.5px] font-medium text-[var(--ink-muted)] transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-strong)]"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Switch to dark mode"
          aria-pressed="false"
          class="hidden h-9 w-9 items-center justify-center rounded-full text-[var(--ink-muted)] transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-strong)] sm:inline-flex"
        >
          <svg class="theme-sun h-[16px] w-[16px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg class="theme-moon h-[16px] w-[16px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>

        <a
          href="https://github.com/sachncs/promptsheon"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden h-9 items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--bg-elevated)] px-3.5 text-[13px] font-medium text-[var(--ink)] transition-all hover:border-[var(--line-strong)] md:inline-flex"
        >
          <svg viewBox="0 0 24 24" class="h-[14px] w-[14px]" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.73-1.53-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
          </svg>
          <span>Star</span>
          <span class="font-mono text-[12px] text-[var(--ink-subtle)]">·</span>
          <span class="font-mono text-[12px] text-[var(--ink-subtle)]">GitHub</span>
        </a>

        <a href={`${base}docs/quickstart/`} class="ps-btn ps-btn-primary hidden sm:inline-flex">
          Start with docs
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>

        <button
          id="mobile-nav-toggle"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          class="grid h-9 w-9 place-items-center rounded-full text-[var(--ink-muted)] transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-strong)] lg:hidden"
        >
          <svg class="icon-menu h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
          <svg class="icon-close hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu panel -->
    <div
      id="mobile-nav-panel"
      class="hidden border-t border-[var(--line)] pb-4 pt-2 lg:hidden"
    >
      <nav class="flex flex-col gap-1" aria-label="Mobile">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="rounded-lg px-3 py-2.5 text-[14px] font-medium text-[var(--ink-muted)] transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-strong)]"
          >
            {link.label}
          </a>
        ))}
      </nav>
      <div class="mt-2 border-t border-[var(--line)] pt-2">
        <a href={`${base}docs/quickstart/`} class="ps-btn ps-btn-primary mb-1 w-full justify-center">
          Start with the quickstart
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
        <button
          id="mobile-theme-toggle"
          type="button"
          aria-label="Switch to dark mode"
          aria-pressed="false"
          class="flex w-full items-center gap-2 rounded-lg px-3 py-2.5 text-left text-[14px] font-medium text-[var(--ink-muted)] transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-strong)]"
        >
          <svg class="theme-sun h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg class="theme-moon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <span class="theme-label">Use dark mode</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  function onScroll() {
    if (!nav) return;
    const scrolled = window.scrollY > 8;
    nav.classList.toggle('border-[var(--line)]', scrolled);
    nav.classList.toggle('bg-[var(--bg-overlay)]', scrolled);
    nav.classList.toggle('backdrop-blur-xl', scrolled);
  }
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const themeToggles = document.querySelectorAll('#theme-toggle, #mobile-theme-toggle');
  function syncThemeControls() {
    const isDark = document.documentElement.classList.contains('dark');
    const label = isDark ? 'Switch to light mode' : 'Switch to dark mode';
    themeToggles.forEach((toggle) => {
      toggle.setAttribute('aria-label', label);
      toggle.setAttribute('aria-pressed', String(isDark));
      const text = toggle.querySelector('.theme-label');
      if (text) text.textContent = isDark ? 'Use light mode' : 'Use dark mode';
    });
  }
  syncThemeControls();
  themeToggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('promptsheon-theme', isDark ? 'dark' : 'light');
      syncThemeControls();
    });
  });

  const mobileToggle = document.getElementById('mobile-nav-toggle');
  const mobilePanel = document.getElementById('mobile-nav-panel');
  const iconMenu = mobileToggle?.querySelector('.icon-menu') as HTMLElement | null;
  const iconClose = mobileToggle?.querySelector('.icon-close') as HTMLElement | null;
  let previousBodyOverflow = '';

  if (mobileToggle instanceof HTMLButtonElement && mobilePanel instanceof HTMLElement) {
    const toggle = mobileToggle;
    const panel = mobilePanel;

    function setMobileNav(open: boolean, restoreFocus = false) {
      if (open) {
        previousBodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
      } else {
        panel.classList.add('hidden');
        document.body.style.overflow = previousBodyOverflow;
      }

      if (open) panel.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      iconMenu?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);

      if (restoreFocus) toggle.focus();
    }

    toggle.addEventListener('click', () => {
      const open = !panel.classList.contains('hidden');
      setMobileNav(!open);
    });

    // Close on link click
    panel.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setMobileNav(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.classList.contains('hidden')) {
        setMobileNav(false, true);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && !panel.classList.contains('hidden')) {
        setMobileNav(false);
      }
    }, { passive: true });
  }
</script>
