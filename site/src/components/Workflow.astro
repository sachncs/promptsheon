---
const base = import.meta.env.BASE_URL;

const steps = [
  {
    step: '01',
    title: 'Create',
    body: 'Turn an objective into an immutable agent or organization specification with explicit policies and success criteria.',
    output: 'Content-addressed AgentSpec',
    tone: 'indigo',
  },
  {
    step: '02',
    title: 'Execute',
    body: 'The Operator schedules the graph, routes models, invokes tools, and produces a trace within its budget.',
    output: 'Execution trace + artifacts',
    tone: 'emerald',
  },
  {
    step: '03',
    title: 'Observe + evaluate',
    body: 'Measure outcome quality, tokens, context, latency, cost, retries, tools, permissions, and human intervention.',
    output: 'Evidence vector + decision',
    tone: 'amber',
  },
  {
    step: '04',
    title: 'Learn',
    body: 'Compare like workloads, trace causality through lineage, and store reusable patterns about what improves an agent.',
    output: 'Pattern + recommendation',
    tone: 'rose',
  },
  {
    step: '05',
    title: 'Mutate → validate → promote',
    body: 'Test a targeted change through replay, benchmarks, shadow traffic, or controlled rollout before promotion.',
    output: 'Candidate lineage + promotion',
    tone: 'sky',
  },
];

const tones: Record<string, { dot: string; text: string; bg: string }> = {
  indigo:  { dot: 'bg-[var(--brand-graphite)]', text: 'text-[var(--brand-graphite)]', bg: 'bg-[var(--brand-graphite)]/10' },
  emerald: { dot: 'bg-[var(--brand-steel)]', text: 'text-[var(--brand-steel)]', bg: 'bg-[var(--brand-steel)]/10' },
  amber:   { dot: 'bg-[var(--brand-silver)]', text: 'text-[var(--brand-steel)]', bg: 'bg-[var(--brand-silver)]/20' },
  rose:    { dot: 'bg-[var(--brand-graphite)]', text: 'text-[var(--brand-graphite)]', bg: 'bg-[var(--brand-graphite)]/10' },
  sky:     { dot: 'bg-[var(--brand-steel)]', text: 'text-[var(--brand-steel)]', bg: 'bg-[var(--brand-steel)]/10' },
};

const evidence = [
  {
    label: 'Content',
    value: 'sha256:9c4f…a02b',
    detail: 'The exact manifest that was evaluated and approved.',
  },
  {
    label: 'Decision',
    value: '0.92 / 0.90 threshold',
    detail: 'The release gate and the score that cleared it.',
  },
  {
    label: 'Recovery',
    value: 'v2 ready to restore',
    detail: 'The previous active version stays available for rollback.',
  },
];
---

<section id="workflow" class="ps-section border-t border-[var(--line)]">
  <div class="ps-container">
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4 lg:sticky lg:top-28 lg:self-start">
        <div class="ps-reveal ps-eyebrow">Workflow</div>
        <h2 class="ps-reveal ps-display mt-4 text-display-lg" style="--reveal-delay: 80ms">
          From execution to improvement.
        </h2>
        <p class="ps-reveal mt-5 text-[16.5px] leading-relaxed text-[var(--ink-muted)] text-pretty" style="--reveal-delay: 160ms">
          Every execution becomes evidence. The platform uses that evidence to decide
          what to change, what to keep, and what the system can safely afford.
        </p>

        <div class="ps-reveal mt-8 hidden lg:block" style="--reveal-delay: 220ms">
          <div class="rounded-2xl border border-[var(--line)] bg-[var(--bg-elevated)] p-5 shadow-soft">
            <div class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-[var(--ink-subtle)]">Adaptive loop</div>
            <div class="mt-4 flex flex-wrap items-center gap-1.5 text-[11px] font-medium">
              {['create', 'execute', 'observe', 'learn', 'promote'].map((state, idx) => (
                <>
                  <span class="rounded-md bg-[var(--bg-subtle)] px-2 py-1 font-mono text-[var(--ink)]">{state}</span>
                  {idx < 4 && <span class="text-[var(--ink-subtle)]">→</span>}
                </>
              ))}
            </div>
            <div class="mt-4 flex items-center gap-2 text-[11px] text-[var(--ink-muted)]">
              <span class="ps-hash">v3</span>
              <span>agent:8f37… · candidate:9c4f…</span>
            </div>
          </div>
        </div>
      </div>

      <ol class="lg:col-span-8 space-y-4">
        {steps.map((s, idx) => (
          <li
            class="ps-card ps-reveal relative flex gap-5 p-5 sm:p-6"
            style={`--reveal-delay: ${idx * 70}ms`}
          >
            <div class="shrink-0">
              <div class={`grid h-10 w-10 place-items-center rounded-lg ${tones[s.tone].bg} font-mono text-[11px] font-semibold ${tones[s.tone].text}`}>
                {s.step}
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <h3 class="font-semibold text-[16.5px] tracking-tight text-[var(--ink-strong)]">
                  {s.title}
                </h3>
                <span class={`ml-1 inline-block h-1.5 w-1.5 rounded-full ${tones[s.tone].dot}`}></span>
              </div>
              <p class="mt-1.5 text-[14.5px] leading-relaxed text-[var(--ink-muted)] text-pretty">
                {s.body}
              </p>
              <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-[var(--line)] pt-3">
                <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--ink-subtle)]">Output</span>
                <span class="rounded-md bg-[var(--bg-subtle)] px-2 py-1 font-mono text-[11px] text-[var(--ink)]">
                  {s.output}
                </span>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="ps-reveal mt-16 border-t border-[var(--line)] pt-8" style="--reveal-delay: 180ms">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <div class="ps-eyebrow">Evidence trail</div>
          <h3 class="ps-display mt-3 text-display-sm">The release carries its evidence.</h3>
        </div>
        <a class="ps-link text-[13px]" href={`${base}docs/architecture/`}>See the architecture <span aria-hidden="true">→</span></a>
      </div>

      <div class="mt-7 grid gap-4 md:grid-cols-3">
        {evidence.map((item) => (
          <article class="rounded-2xl border border-[var(--line)] bg-[var(--bg-elevated)] p-5 shadow-soft">
            <div class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-[var(--ink-subtle)]">{item.label}</div>
            <div class="mt-3 font-mono text-[13px] font-semibold text-[var(--ink-strong)]">{item.value}</div>
            <p class="mt-2 text-[13px] leading-relaxed text-[var(--ink-muted)]">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
