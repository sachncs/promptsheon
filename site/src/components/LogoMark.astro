---
export interface Props {
  size?: number;
  className?: string;
}
const { size = 28, className = '' } = Astro.props;
---

<img
  src="/promptsheon-mark-hd.png"
  width={size}
  height={size}
  role="img"
  aria-label="Promptsheon"
  alt="Promptsheon"
  class={`inline-block object-contain ${className}`}
/>
