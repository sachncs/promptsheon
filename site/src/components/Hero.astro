---
---

<section class="relative overflow-hidden ps-vignette ps-noise">
  <div class="ps-grid-bg absolute inset-0 -z-10 opacity-60"></div>

  <!-- Floating ambient orbs for cinematic depth -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute -left-32 top-24 h-[420px] w-[420px] rounded-full bg-[var(--accent)] opacity-[0.07] blur-[120px]"></div>
    <div class="absolute right-[-160px] top-0 h-[480px] w-[480px] rounded-full bg-indigo-400 opacity-[0.05] blur-[140px] dark:opacity-[0.10]"></div>
  </div>

  <div class="ps-container relative">
    <div class="pt-28 pb-20 text-center sm:pt-36 sm:pb-28 lg:pt-44 lg:pb-36">
      <!-- Eyebrow -->
      <div class="ps-reveal inline-flex items-center gap-2.5 rounded-full border border-[var(--line)] bg-[var(--bg-overlay)] px-3.5 py-1.5 text-[12px] text-[var(--ink-muted)] backdrop-blur">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        </span>
        v0.1 — Self-hosted. No telemetry. Apache-2.0.
      </div>

      <!-- Headline -->
      <h1
        class="ps-reveal ps-display mt-8 text-[clamp(2.75rem,7vw,5.75rem)]"
        style="--reveal-delay: 80ms"
      >
        The control plane for
        <span class="block bg-gradient-to-br from-[var(--ink-strong)] via-[var(--ink-strong)] to-[var(--accent)] bg-clip-text text-transparent dark:from-white dark:via-white dark:to-[#A5B4FC]">
          AI capabilities.
        </span>
      </h1>

      <p
        class="ps-reveal mx-auto mt-7 max-w-2xl text-[18px] leading-relaxed text-[var(--ink-muted)] sm:text-[19px] text-pretty"
        style="--reveal-delay: 160ms"
      >
        Promptsheon manages prompts, agents, policies, tools, MCP servers, guardrails,
        and evaluation suites as content-addressed, governed, version-controlled release
        artifacts. Not chat. Not notebooks. <span class="text-[var(--ink)]">Production infrastructure.</span>
      </p>

      <div
        class="ps-reveal mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-3"
        style="--reveal-delay: 240ms"
      >
        <a href="#install" class="ps-btn ps-btn-primary ps-btn-lg group">
          <span>Get started</span>
          <span class="arrow-nudge">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </span>
        </a>
        <a href="#workflow" class="ps-btn ps-btn-secondary ps-btn-lg">
          See the workflow
        </a>
      </div>

      <div
        class="ps-reveal mt-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[12.5px] text-[var(--ink-subtle)]"
        style="--reveal-delay: 320ms"
      >
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5" />
          </svg>
          Fastify + Next.js 16
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5" />
          </svg>
          Strands Agents SDK
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5" />
          </svg>
          Cedar policy engine
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5" />
          </svg>
          Runs on your laptop
        </span>
      </div>
    </div>

    <!-- Product preview / hero card -->
    <div
      class="ps-reveal relative mx-auto mt-12 max-w-[1080px] sm:mt-16"
      style="--reveal-delay: 360ms"
    >
      <!-- Subtle outer glow -->
      <div aria-hidden="true" class="absolute -inset-10 -z-10 rounded-[2.5rem] bg-gradient-to-br from-[var(--accent)] to-fuchsia-500 opacity-20 blur-3xl"></div>

      <div class="relative overflow-hidden rounded-[1.75rem] border border-[var(--line-strong)] bg-[var(--bg-elevated)] shadow-[0_50px_120px_-30px_rgba(15,17,23,0.35)]">
        <!-- Window chrome -->
        <div class="flex items-center justify-between gap-4 border-b border-[var(--line)] bg-[var(--bg-subtle)] px-4 py-3">
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-[#FF5F57]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#FEBC2E]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#28C840]"></span>
          </div>
          <div class="flex items-center gap-2 rounded-md bg-[var(--bg)] px-3 py-1 text-[11.5px] text-[var(--ink-subtle)] font-mono">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            promptsheon.local:3000/capabilities/refund-triage
          </div>
          <div class="flex items-center gap-2">
            <span class="ps-pill" style="height:22px;">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              canary
            </span>
          </div>
        </div>

        <!-- Main 2-column product surface -->
        <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr]">
          <!-- Sidebar: DAG nodes -->
          <aside class="hidden border-r border-[var(--line)] bg-[var(--bg-subtle)] p-4 lg:block">
            <div class="mb-3 flex items-center justify-between">
              <span class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-[var(--ink-subtle)]">Graph</span>
              <span class="text-[10.5px] text-[var(--ink-subtle)]">4 nodes</span>
            </div>
            <ul class="space-y-2">
              {[
                { type: 'planner',   name: 'classify',  model: 'claude-3-5', tone: '#6366F1' },
                { type: 'agent',     name: 'retrieve',  model: 'tool: orders', tone: '#10B981' },
                { type: 'guardrail', name: 'reviewer',  model: 'policy v2',   tone: '#F59E0B' },
                { type: 'agent',     name: 'respond',   model: 'pii-redact',  tone: '#10B981' },
              ].map((node) => (
                <li class="group flex items-center gap-3 rounded-lg border border-[var(--line)] bg-[var(--bg-elevated)] p-2.5 transition-colors hover:border-[var(--line-strong)]">
                  <span class="flex h-7 w-7 items-center justify-center rounded-md text-[10px] font-bold uppercase tracking-wider text-white" style={`background:${node.tone}`}>
                    {node.type[0]}
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="truncate text-[12.5px] font-medium text-[var(--ink-strong)]">{node.name}</div>
                    <div class="truncate font-mono text-[10.5px] text-[var(--ink-subtle)]">{node.model}</div>
                  </div>
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse-soft"></span>
                </li>
              ))}
            </ul>

            <div class="mt-6 border-t border-[var(--line)] pt-4">
              <div class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-[var(--ink-subtle)]">Routing</div>
              <div class="mt-3 space-y-2.5">
                <div>
                  <div class="flex items-center justify-between text-[11px] text-[var(--ink-muted)]">
                    <span>canary</span><span class="font-mono text-[var(--ink-subtle)]">20%</span>
                  </div>
                  <div class="mt-1 h-1 overflow-hidden rounded-full bg-[var(--line)]">
                    <div class="h-full rounded-full bg-amber-500" style="width:20%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex items-center justify-between text-[11px] text-[var(--ink-muted)]">
                    <span>stable</span><span class="font-mono text-[var(--ink-subtle)]">80%</span>
                  </div>
                  <div class="mt-1 h-1 overflow-hidden rounded-full bg-[var(--line)]">
                    <div class="h-full rounded-full bg-emerald-500" style="width:80%"></div>
                  </div>
                </div>
              </div>
            </div>
          </aside>

          <!-- Right: tabs + manifest diff + eval scores -->
          <div class="min-w-0">
            <!-- Tabs -->
            <div class="flex items-center gap-1 border-b border-[var(--line)] bg-[var(--bg-elevated)] px-3 pt-2.5">
              <span class="rounded-t-md border-b-2 border-[var(--accent)] px-3 py-1.5 text-[12.5px] font-medium text-[var(--ink-strong)]">Manifest</span>
              <span class="px-3 py-1.5 text-[12.5px] text-[var(--ink-muted)]">Evals</span>
              <span class="px-3 py-1.5 text-[12.5px] text-[var(--ink-muted)]">Audit</span>
              <span class="px-3 py-1.5 text-[12.5px] text-[var(--ink-muted)]">Activity</span>
              <span class="ml-auto flex items-center gap-1.5 pb-1.5 pr-1">
                <span class="ps-hash">sha256:9c4f…a02b</span>
              </span>
            </div>

            <!-- Diff content -->
            <div class="bg-[var(--bg-code)] p-5 sm:p-6">
              <pre class="overflow-x-auto font-mono text-[12.5px] leading-[1.7] text-[#E8ECF5]"><code><span class="text-[#6C7591]"># capability</span>
<span class="text-[#A5B4FC]">name</span>:  refund-triage
<span class="text-[#A5B4FC]">version</span>: 3
<span class="text-[#A5B4FC]">graph</span>:
  <span class="text-[#6C7591]">-</span> <span class="text-[#34D399]">classify</span>:  <span class="text-[#FBBF24]">&#123; model: claude-3-5 &#125;</span>
  <span class="text-[#6C7591]">-</span> <span class="text-[#34D399]">retrieve</span>:  <span class="text-[#FBBF24]">&#123; tool: orders &#125;</span>
  <span class="text-[#6C7591]">-</span> <span class="text-[#34D399]">decide</span>:    <span class="text-[#FBBF24]">~ reviewer policy v2</span>   <span class="text-[#6C7591]"># +12 lines</span>
  <span class="text-[#6C7591]">-</span> <span class="text-[#34D399]">respond</span>:   <span class="text-[#F87171]">&#123; guardrail: pii-redact &#125;</span>   <span class="text-[#6C7591]"># scrub list</span>

<span class="text-[#6C7591]"># eval</span>
<span class="text-[#A5B4FC]">suite</span>:     refund-suite
<span class="text-[#A5B4FC]">threshold</span>: <span class="text-[#34D399]">0.92</span>
<span class="text-[#A5B4FC]">scorers</span>:   <span>[exact-match, llm-judge, regex]</span></code></pre>
            </div>

            <!-- Eval results strip -->
            <div class="grid grid-cols-3 divide-x divide-[var(--line)] border-t border-[var(--line)] bg-[var(--bg-subtle)]">
              <div class="p-4">
                <div class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-[var(--ink-subtle)]">Score</div>
                <div class="mt-1.5 flex items-baseline gap-1.5">
                  <span class="font-mono text-[22px] font-semibold text-[var(--ink-strong)]">0.94</span>
                  <span class="text-[11px] text-emerald-600 dark:text-emerald-400">▲ 0.02</span>
                </div>
              </div>
              <div class="p-4">
                <div class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-[var(--ink-subtle)]">Latency p95</div>
                <div class="mt-1.5 flex items-baseline gap-1.5">
                  <span class="font-mono text-[22px] font-semibold text-[var(--ink-strong)]">1.2s</span>
                  <span class="text-[11px] text-emerald-600 dark:text-emerald-400">▼ 0.3s</span>
                </div>
              </div>
              <div class="p-4">
                <div class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-[var(--ink-subtle)]">Drift</div>
                <div class="mt-1.5 flex items-baseline gap-1.5">
                  <span class="font-mono text-[22px] font-semibold text-[var(--ink-strong)]">0.3%</span>
                  <span class="text-[11px] text-[var(--ink-subtle)]">stable</span>
                </div>
              </div>
            </div>

            <!-- Footer row: approval state -->
            <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line)] bg-[var(--bg-elevated)] px-5 py-3 text-[11.5px]">
              <div class="flex items-center gap-2 text-[var(--ink-muted)]">
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                </span>
                Approved by <span class="font-medium text-[var(--ink)]">m.chen</span> · 4 min ago
              </div>
              <div class="flex items-center gap-2">
                <span class="ps-hash">0x9c…a02b</span>
                <button class="rounded-md border border-[var(--line)] bg-[var(--bg-elevated)] px-2.5 py-1 font-medium text-[var(--ink)] transition-colors hover:border-[var(--line-strong)]">View audit</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Floating badges: tucked into the gutter above the card so they don't collide with the DAG list -->
      <div class="pointer-events-none absolute -top-6 left-6 hidden md:block">
        <div class="animate-float-slow rounded-xl border border-[var(--line)] bg-[var(--bg-elevated)] px-3 py-2 shadow-soft">
          <div class="flex items-center gap-2 text-[11px]">
            <span class="flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-mono text-[var(--ink-muted)]">promote → prod</span>
          </div>
        </div>
      </div>
      <div class="pointer-events-none absolute -top-6 right-6 hidden md:block">
        <div class="animate-float-slow rounded-xl border border-[var(--line)] bg-[var(--bg-elevated)] px-3 py-2 shadow-soft" style="animation-delay: 1.4s">
          <div class="flex items-center gap-2 text-[11px]">
            <svg class="h-3 w-3 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 9v4M12 17h.01M10.29 3.86l-8.18 14.18A2 2 0 0 0 3.83 21h16.34a2 2 0 0 0 1.72-2.96l-8.18-14.18a2 2 0 0 0-3.42 0z" />
            </svg>
            <span class="font-mono text-[var(--ink-muted)]">rollback ready</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .arrow-nudge { transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1); }
  .ps-btn-primary:hover .arrow-nudge { transform: translateX(3px); }
  :global(html:not(.dark)) .theme-moon { display: none; }
  :global(html.dark) .theme-sun { display: none; }
</style>