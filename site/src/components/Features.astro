---
const features = [
  {
    title: 'Visual DAG editor',
    text: 'Compose agents, policies, tools, and memory into a graph. Live execution preview against real data, on your machine.',
    icon: 'workflow',
  },
  {
    title: 'Releases with canary',
    text: 'Weighted traffic split. Live eval scores monitor canary. One-click rollback — hash-linked and signed.',
    icon: 'rocket',
  },
  {
    title: 'Maker-checker approvals',
    text: 'The creator cannot approve their own release. The reason and voter are persisted with the audit row.',
    icon: 'shield',
  },
  {
    title: 'Content-addressed CAS',
    text: 'Every compiled manifest is hashed and stored by content. Same input, same hash, immovable identity.',
    icon: 'fingerprint',
  },
  {
    title: 'Evaluation engine',
    text: 'Declarative datasets, pluggable scorers, regression gates, parallel runs. Compare models side by side.',
    icon: 'flask',
  },
  {
    title: 'Self-evolution loop',
    text: 'Watches live eval scores; on regression, re-plans the manifest and re-releases with cooldown.',
    icon: 'telescope',
  },
];

const icons: Record<string, string> = {
  workflow:   'M5 3v6M19 9V3M5 15v6M19 21v-6M9 3h6M9 21h6M3 9h6M15 21h6M15 3h6M3 15h6',
  rocket:     'M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09zM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2zM9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5',
  shield:     'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  fingerprint:'M2 12C2 6.5 6.5 2 12 2a10 10 0 0 1 10 10M7 21c-.5-1.5-1-3-1-5a6 6 0 0 1 12 0M9 16v-3M12 16v-6M15 16v-3M9 9.5a3 3 0 0 1 6 0',
  flask:      'M9 3h6M10 3v6.5L4.5 19a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L14 9.5V3',
  telescope:  'M3 21l6-9M9 12l3-9 9 3-3 9zM14 6l-2 4M5 21h14',
};
---

<section id="capabilities" class="ps-section-tight border-t border-[var(--line)] bg-[var(--bg-subtle)]">
  <div class="ps-container">
    <div class="mx-auto max-w-3xl text-center">
      <div class="ps-reveal ps-eyebrow">What you get</div>
      <h2 class="ps-reveal ps-display mt-4 text-display-lg" style="--reveal-delay: 80ms">
        Six capabilities that ship together.
      </h2>
      <p class="ps-reveal mx-auto mt-5 max-w-2xl text-[17px] leading-relaxed text-[var(--ink-muted)] text-pretty" style="--reveal-delay: 160ms">
        No bolt-ons. No beta flags. Every release of Promptsheon includes the
        whole stack — DAG editor, eval engine, audit chain, canary rollout,
        maker-checker, and the self-evolution loop.
      </p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {features.map((f, i) => (
        <article
          class="ps-card ps-reveal group p-6"
          style={`--reveal-delay: ${i * 60}ms`}
        >
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--accent-soft)] text-[var(--accent)] transition-all group-hover:scale-105">
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[f.icon]} />
            </svg>
          </div>
          <h3 class="mt-5 font-semibold text-[16px] tracking-tight text-[var(--ink-strong)]">
            {f.title}
          </h3>
          <p class="mt-2 text-[14px] leading-relaxed text-[var(--ink-muted)] text-pretty">
            {f.text}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
