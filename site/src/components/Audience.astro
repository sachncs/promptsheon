---
const base = import.meta.env.BASE_URL;

const audiences = [
  {
    role: 'Architect',
    title: 'Design agent systems as executable specifications.',
    body: 'Compose prompts, tools, policies, context, models, budgets, and evaluations into immutable agent and organization graphs with inspectable lineage.',
    signal: 'Design with intent',
  },
  {
    role: 'Operator',
    title: 'Execute the right work with the right resources.',
    body: 'Schedule dependencies, route models, invoke tools, reuse safe results, and enforce limits while the runtime turns a specification into outcomes.',
    signal: 'Reliable execution',
  },
  {
    role: 'Evaluator + Governor',
    title: 'Improve quality under real constraints.',
    body: 'Measure outcomes, cost, latency, context, tools, and permissions, then enforce hard limits so better results do not depend on unlimited computation.',
    signal: 'Evidence over intuition',
  },
];
---

<section id="audience" class="ps-section border-t border-[var(--line)] bg-[var(--bg-subtle)]">
  <div class="ps-container">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <div class="ps-reveal ps-eyebrow">Who it is for</div>
        <h2 class="ps-reveal ps-display mt-4 text-display-lg" style="--reveal-delay: 80ms">
          The system between a promising agent and a better one.
        </h2>
        <p class="ps-reveal mt-5 max-w-md text-[16.5px] leading-relaxed text-[var(--ink-muted)] text-pretty" style="--reveal-delay: 160ms">
          Most agent platforms focus on running agents. Promptsheon focuses on
          making agent systems improve: create, execute, observe, evaluate, compare,
          learn, mutate, validate, and promote.
        </p>
        <a href={`${base}docs/architecture/`} class="ps-reveal mt-7 inline-flex items-center gap-2 text-[13.5px] font-medium text-[var(--accent)] hover:underline" style="--reveal-delay: 220ms">
          See the architecture <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid gap-4">
        {audiences.map((audience, i) => (
          <article class="ps-card ps-reveal group p-6 sm:p-7" style={`--reveal-delay: ${i * 80}ms`}>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="ps-eyebrow">{audience.role}</span>
              <span class="rounded-full border border-[var(--line)] bg-[var(--bg-subtle)] px-2.5 py-1 text-[11px] font-medium text-[var(--ink-subtle)]">{audience.signal}</span>
            </div>
            <h3 class="mt-5 max-w-xl text-[21px] font-semibold tracking-tight text-[var(--ink-strong)]">{audience.title}</h3>
            <p class="mt-2 max-w-2xl text-[14.5px] leading-relaxed text-[var(--ink-muted)] text-pretty">{audience.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
