---
import '../styles/global.css';
import SiteHead from './SiteHead.astro';
import SiteNav from './SiteNav.astro';
import SiteFooter from './SiteFooter.astro';

export interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow = 'Developer docs' } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const links = [
  { label: 'Documentation home', href: `${base}docs/` },
  { label: 'Product model', href: `${base}docs/product/` },
  { label: 'Quickstart', href: `${base}docs/quickstart/` },
  { label: 'Local development', href: `${base}docs/local-development/` },
  { label: 'Testing', href: `${base}docs/testing/` },
  { label: 'Architecture', href: `${base}docs/architecture/` },
  { label: 'API & SDK', href: `${base}docs/api/` },
  { label: 'Deployment', href: `${base}docs/deployment/` },
  { label: 'Operations', href: `${base}docs/operations/` },
  { label: 'Troubleshooting', href: `${base}docs/troubleshooting/` },
  { label: 'Contributing', href: `${base}docs/contributing/` },
];
const currentIndex = links.findIndex((link) => link.href === currentPath);
const previousLink = currentIndex > 0 ? links[currentIndex - 1] : undefined;
const nextLink = currentIndex >= 0 && currentIndex < links.length - 1 ? links[currentIndex + 1] : undefined;
---

<!doctype html>
<html lang="en">
    <head>
      <script is:inline>document.documentElement.classList.add('js');</script>
      <SiteHead title={`${title} — Promptsheon`} description={description} />
    </head>
  <body class="bg-surface text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only fixed left-4 top-4 z-50 rounded-md bg-white px-3 py-2 text-sm font-medium text-ink-strong shadow-lg ring-1 ring-[var(--line)]">Skip to content</a>
    <SiteNav />
    <main id="main">
      <div class="border-b border-[var(--line)] bg-[var(--bg-subtle)]">
        <div class="ps-container py-14 sm:py-20">
          <div class="max-w-3xl">
            <div class="ps-eyebrow">{eyebrow}</div>
            <h1 class="ps-display mt-4 text-display-lg">{title}</h1>
            <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-[var(--ink-muted)] text-pretty">{description}</p>
          </div>
        </div>
      </div>
      <div class="ps-container grid gap-12 py-12 lg:grid-cols-[220px_minmax(0,760px)] lg:gap-20 lg:py-16">
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <details class="rounded-xl border border-[var(--line)] bg-[var(--bg-elevated)] p-3 lg:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-2 py-1 text-[13px] font-semibold text-[var(--ink-strong)] [&::-webkit-details-marker]:hidden">
              <span>On this site</span>
              <span class="text-[var(--ink-subtle)]">Browse sections</span>
            </summary>
            <nav aria-label="Documentation" class="mt-3 border-t border-[var(--line)] pt-3">
              <ul class="space-y-0.5">
                {links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={link.href === currentPath ? 'page' : undefined}
                      class={`block rounded-lg px-2.5 py-2 text-[13px] transition-colors ${link.href === currentPath ? 'bg-[var(--accent-soft)] font-medium text-[var(--ink-strong)]' : 'text-[var(--ink-muted)] hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-strong)]'}`}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
          <nav aria-label="Documentation" class="hidden rounded-xl border border-[var(--line)] bg-[var(--bg-elevated)] p-3 lg:block">
            <div class="px-2 pb-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--ink-subtle)]">On this site</div>
            <ul class="space-y-0.5">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={link.href === currentPath ? 'page' : undefined}
                    class={`block rounded-lg px-2.5 py-2 text-[13px] transition-colors ${link.href === currentPath ? 'bg-[var(--accent-soft)] font-medium text-[var(--ink-strong)]' : 'text-[var(--ink-muted)] hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-strong)]'}`}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="mt-4 rounded-xl border border-[var(--line)] bg-[var(--bg-subtle)] p-4 text-[12.5px] leading-relaxed text-[var(--ink-muted)]">
            <div class="font-semibold text-[var(--ink-strong)]">Keep the product context</div>
            <p class="mt-1.5">Return to the product overview, or inspect the source when you need implementation detail.</p>
            <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5">
              <a class="font-medium text-[var(--accent)] hover:underline" href={base}>Product overview →</a>
              <a class="font-medium text-[var(--accent)] hover:underline" href="https://github.com/sachncs/promptsheon" target="_blank" rel="noopener noreferrer">Source →</a>
            </div>
          </div>
        </aside>
        <article class="docs-prose min-w-0">
          <slot />
          <nav aria-label="Documentation pagination" class="mt-16 grid gap-3 border-t border-[var(--line)] pt-6 sm:grid-cols-2">
            {previousLink ? (
              <a href={previousLink.href} class="group rounded-xl border border-[var(--line)] bg-[var(--bg-elevated)] p-4 transition-colors hover:border-[var(--line-strong)] hover:bg-[var(--bg-subtle)]">
                <span class="block text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--ink-subtle)]">Previous</span>
                <span class="mt-2 block font-medium text-[var(--ink-strong)]">← {previousLink.label}</span>
              </a>
            ) : <span></span>}
            {nextLink ? (
              <a href={nextLink.href} class="group rounded-xl border border-[var(--line)] bg-[var(--bg-elevated)] p-4 text-left transition-colors hover:border-[var(--line-strong)] hover:bg-[var(--bg-subtle)] sm:text-right">
                <span class="block text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--ink-subtle)]">Next</span>
                <span class="mt-2 block font-medium text-[var(--ink-strong)]">{nextLink.label} →</span>
              </a>
            ) : <span></span>}
          </nav>
        </article>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
