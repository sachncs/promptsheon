---
import '../styles/global.css';
import SiteHead from './SiteHead.astro';
import SiteNav from './SiteNav.astro';
import SiteFooter from './SiteFooter.astro';

export interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow = 'Developer docs' } = Astro.props;

const links = [
  { label: 'Documentation home', href: '/docs/' },
  { label: 'Quickstart', href: '/docs/quickstart/' },
  { label: 'Architecture', href: '/docs/architecture/' },
  { label: 'API & SDK', href: '/docs/api/' },
  { label: 'Operations', href: '/docs/operations/' },
  { label: 'Contributing', href: '/docs/contributing/' },
];
---

<!doctype html>
<html lang="en">
  <head><SiteHead title={`${title} — Promptsheon`} description={description} /></head>
  <body class="bg-surface text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only fixed left-4 top-4 z-50 rounded-md bg-white px-3 py-2 text-sm font-medium text-ink-strong shadow-lg ring-1 ring-[var(--line)]">Skip to content</a>
    <SiteNav />
    <main id="main">
      <div class="border-b border-[var(--line)] bg-[var(--bg-subtle)]">
        <div class="ps-container py-14 sm:py-20">
          <div class="max-w-3xl">
            <div class="ps-eyebrow">{eyebrow}</div>
            <h1 class="ps-display mt-4 text-display-lg">{title}</h1>
            <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-[var(--ink-muted)] text-pretty">{description}</p>
          </div>
        </div>
      </div>
      <div class="ps-container grid gap-12 py-12 lg:grid-cols-[220px_minmax(0,760px)] lg:gap-20 lg:py-16">
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <nav aria-label="Documentation" class="rounded-xl border border-[var(--line)] bg-[var(--bg-elevated)] p-3">
            <div class="px-2 pb-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--ink-subtle)]">On this site</div>
            <ul class="space-y-0.5">
              {links.map((link) => (
                <li><a href={link.href} class="block rounded-lg px-2.5 py-2 text-[13px] text-[var(--ink-muted)] transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--ink-strong)]">{link.label}</a></li>
              ))}
            </ul>
          </nav>
          <div class="mt-4 rounded-xl border border-[var(--line)] bg-[var(--bg-subtle)] p-4 text-[12.5px] leading-relaxed text-[var(--ink-muted)]">
            <div class="font-semibold text-[var(--ink-strong)]">Need the source?</div>
            <p class="mt-1.5">The project is open source and self-hosted. Use GitHub for issues, releases, and source history.</p>
            <a class="mt-3 inline-flex font-medium text-[var(--accent)] hover:underline" href="https://github.com/sachncs/promptsheon" target="_blank" rel="noopener noreferrer">View repository →</a>
          </div>
        </aside>
        <article class="docs-prose min-w-0">
          <slot />
        </article>
      </div>
    </main>
    <SiteFooter />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('promptsheon-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if ((stored ?? (prefersDark ? 'dark' : 'light')) === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
  </body>
</html>
