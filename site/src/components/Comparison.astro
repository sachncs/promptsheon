---
const rows = [
  { key: 'Visibility',     a: '—',                  b: 'partial',              c: 'self-hosted, full',          highlight: true },
  { key: 'Audit chain',    a: '—',                  b: 'provider-side',        c: 'hash-linked, verifiable',    highlight: true },
  { key: 'Maker-checker',  a: '—',                  b: 'optional',             c: 'enforced',                   highlight: true },
  { key: 'Canary rollout', a: '—',                  b: 'beta',                 c: 'first-class',                highlight: true },
  { key: 'Rollback',       a: 'manual',             b: 'snapshot',             c: 'one click',                  highlight: true },
  { key: 'Cost model',     a: 'time × seats',       b: 'per-token',            c: 'flat (Apache-2.0)',          highlight: true },
  { key: 'Vendor lock',    a: 'low',                b: 'high',                 c: 'none',                       highlight: true },
];
---

<section id="compare" class="ps-section border-t border-[var(--line)]">
  <div class="ps-container">
    <div class="mx-auto max-w-3xl text-center">
      <div class="ps-reveal ps-eyebrow">Comparison</div>
      <h2 class="ps-reveal ps-display mt-4 text-display-lg" style="--reveal-delay: 80ms">
        Not a notebook. Not hosted SaaS.
      </h2>
      <p class="ps-reveal mx-auto mt-5 max-w-2xl text-[17px] leading-relaxed text-[var(--ink-muted)] text-pretty" style="--reveal-delay: 160ms">
        Promptsheon sits between ad-hoc notebooks and hosted agent platforms.
        You own the infrastructure; we give you the engineering.
      </p>
    </div>

    <div class="ps-reveal mt-12 overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--bg-elevated)] shadow-soft" style="--reveal-delay: 220ms">
      <div class="overflow-x-auto" tabindex="0" aria-label="Comparison table; scroll horizontally to see all columns">
        <table class="w-full min-w-[620px] text-left">
        <thead>
          <tr class="border-b border-[var(--line)] bg-[var(--bg-subtle)] text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--ink-subtle)]">
            <th class="px-5 py-4"></th>
            <th class="px-5 py-4 text-[var(--ink-subtle)]">Notebooks</th>
            <th class="px-5 py-4 text-[var(--ink-subtle)]">Hosted SaaS</th>
            <th class="px-5 py-4 text-[var(--accent)]">Promptsheon</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--line)]">
          {rows.map((row) => (
            <tr class="text-[14px]">
              <td class="px-5 py-3.5 font-medium text-[var(--ink)]">{row.key}</td>
              <td class="px-5 py-3.5 text-[var(--ink-muted)]">{row.a}</td>
              <td class="px-5 py-3.5 text-[var(--ink-muted)]">{row.b}</td>
              <td class={`px-5 py-3.5 font-medium ${row.highlight ? 'text-[var(--ink-strong)]' : 'text-[var(--ink-muted)]'}`}>
                {row.c}
              </td>
            </tr>
          ))}
        </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
