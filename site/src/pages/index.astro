---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import LogoCloud from '@components/LogoCloud.astro';
import Metrics from '@components/Metrics.astro';
import Pillars from '@components/Pillars.astro';
import Features from '@components/Features.astro';
import Workflow from '@components/Workflow.astro';
import Trust from '@components/Trust.astro';
import Comparison from '@components/Comparison.astro';
import Pricing from '@components/Pricing.astro';
import CTA from '@components/CTA.astro';
---

<BaseLayout
  title="Promptsheon — Git-native version control for AI agents"
  description="Promptsheon is a self-hosted platform for shipping AI agents to production. Author multi-agent prompts, ship them safely, prove they don't regress, and roll back when they do."
>
  <Hero />
  <LogoCloud />
  <Metrics />
  <Pillars />
  <Features />
  <Workflow />
  <Trust />
  <Comparison />
  <Pricing />
  <CTA />
</BaseLayout>